# Madera Noble - Environment Variables
# Copy this file to .env.local and fill in your values

# Example: Google Maps API key (only if using embedded maps with API)
# NEXT_PUBLIC_MAPS_API_KEY=

# Example: Analytics ID
# NEXT_PUBLIC_ANALYTICS_ID=

# Contact form endpoint (if using external service like Formspree, Resend, etc.)
# CONTACT_FORM_ENDPOINT=
